# HomePilot Market Intelligence Engine Environment Variables
# Pipeline Architecture: Firecrawl + Python (FastAPI) + Node.js (NestJS) + Grok (xAI API) + MongoDB + Redis
# NOTE: Bright Data and n8n are strictly excluded from this architecture.

# Web Discovery & Ingestion
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
FIRECRAWL_API_URL=https://api.firecrawl.dev

# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=homepilot_intelligence

# Job Coordination & Queues (Redis)
REDIS_URL=redis://localhost:6379/0

# Intelligence & Strategic Reasoning (Grok via xAI API)
XAI_API_KEY=your_xai_api_key_here
GROK_MODEL=grok-2-latest

# Service Ports & Operational Settings
INTELLIGENCE_SERVICE_PORT=8000
APPLICATION_SERVICE_PORT=3000
LOG_LEVEL=INFO
ENVIRONMENT=development
